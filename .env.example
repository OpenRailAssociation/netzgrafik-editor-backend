POSTGRES_USER=asd
POSTGRES_PASSWORD=asd
POSTGRES_DB=nge2134db

DB_HOST=postgres
DB_PORT=5432
# PostgreSQL database name used by the backend.
DB_NAME=${POSTGRES_DB}
# Database username.
DB_USER=${POSTGRES_USER}
# Database password.
DB_PASSWORD=${POSTGRES_PASSWORD}
# JDBC driver class Spring uses for DB connections.
DB_DRIVER_CLASS_NAME=org.postgresql.Driver

# JWT issuer URL from Keycloak realm for token validation.
JWT_ISSUER_URI=https://keycloak.mydomain.com/realms/myrealm
# Expected audience / service identifier inside JWT tokens.
AUTH_SERVICE_NAME=netzgrafik

# SQL dialect jOOQ should generate SQL for.
JOOQ_SQL_DIALECT=Postgres
# Enable Flyway schema migrations at application startup.
FLYWAY_ENABLED=true
# Fail startup if Flyway migration locations are missing.
FLYWAY_FAIL_ON_MISSING_LOCATIONS=true
# Classpath location for Flyway migration scripts.
FLYWAY_LOCATIONS=classpath:db/migration

# URL path pattern for which CORS rules are applied.
CORS_PATH_MAPPINGS=/**
# Allowed browser origins for CORS (use explicit domains outside local dev).
CORS_ALLOWED_ORIGINS=https://nge.mydomain.com
# HTTP methods allowed by CORS.
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE
# HTTP headers allowed by CORS.
CORS_ALLOWED_HEADERS=*

# Spring framework log level. Recommended INFO for production, DEBUG for development.
SPRING_LOG_LEVEL=DEBUG
# Enable/disable OpenAPI JSON endpoint.
SPRINGDOC_API_DOCS_ENABLED=false
# Enable/disable Swagger UI endpoint.
SPRINGDOC_SWAGGER_UI_ENABLED=false
